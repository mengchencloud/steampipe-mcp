# MCP Server Configuration
MCP_PORT=3000

# API Key for Bearer token authentication (leave empty to disable auth)
MCP_API_KEY=your-secret-api-key-here

# Steampipe database connection string
STEAMPIPE_MCP_WORKSPACE_DATABASE=postgresql://steampipe@localhost:9193/steampipe

# For remote Steampipe:
# STEAMPIPE_MCP_WORKSPACE_DATABASE=postgresql://user:password@remote-host:9193/steampipe

# For Turbot Pipes:
# STEAMPIPE_MCP_WORKSPACE_DATABASE=postgresql://user:token@pipes.turbot.com:9193/workspace_db
